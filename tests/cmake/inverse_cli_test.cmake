# Each invocation is a new process: the algorithm construction must survive exit.
include("${CMAKE_CURRENT_LIST_DIR}/cli_common.cmake")
set(crc32 "${WORK}/crc32.bri")

run_cli(0 build crc32 "3132333435????????" "${crc32}")
run_cli(0 inspect "${crc32}")
expect_match("${cli_output}" "direct affine family; free bits: 0" "CRC32 prefix inverse was not compiled as a direct inverse")
run_cli(0 solve "${crc32}" cbf43926 "--output=${WORK}/matches.hex")
expect_output("313233343536373839" "CRC32 inverse failed to recover 123456789")
file(STRINGS "${WORK}/matches.hex" saved)
if(NOT saved STREQUAL "313233343536373839")
    message(FATAL_ERROR "CRC32 inverse failed to persist 123456789")
endif()

run_cli(0 build crc32 "??????????" "${WORK}/family.bri")
run_cli(0 inspect "${WORK}/family.bri")
expect_match("${cli_output}" "direct affine family; free bits: 8" "Five-byte CRC32 inverse lost its free parameters")
run_cli(0 solve "${WORK}/family.bri" cbf43926 --limit=3)
string(REGEX MATCHALL "[0-9a-f]+" matches "${cli_output}")
list(REMOVE_DUPLICATES matches)
list(LENGTH matches count)
if(NOT count EQUAL 3)
    message(FATAL_ERROR "CRC32 inverse did not emit three different matches")
endif()

run_cli(0 build md5 "6d6435??" "${WORK}/md5.bri" --printable)
run_cli(0 solve "${WORK}/md5.bri" b682c4079aa8cae8524986bf8de47f5c)
expect_output("6d643521" "Persisted MD5 inverse failed to recover md5!")
run_cli(2 solve "${WORK}/md5.bri" 00000000000000000000000000000000)
run_cli(1 solve "${crc32}" invalid)
run_cli_keeping("${crc32}" 1 solve "${crc32}" cbf43926 "--output=${crc32}")
run_cli(0 inspect "${crc32}")
