# Synthesizes an MD5 inverse with METHOD (synthesize unless given), solves with
# it, and checks its standalone C++ export.
include("${CMAKE_CURRENT_LIST_DIR}/cli_common.cmake")
if(NOT DEFINED METHOD)
    set(METHOD synthesize)
endif()
set(source "${WORK}/source.bri")
set(inverse "${WORK}/md5.bri")

run_cli(0 build md5 "6d6435??" "${source}")
file(SHA256 "${source}" source_hash)
file(WRITE "${WORK}/limited.bri" "existing artifact")
run_cli_keeping("${WORK}/limited.bri" 1 ${METHOD} "${source}" "${WORK}/limited.bri" --max-nodes=1)
if(METHOD STREQUAL "synthesize")
    expect_match("${cli_error}" "forward: failed" "Limited synthesis did not identify its failing construction phase")
endif()
run_cli_keeping("${source}" 1 ${METHOD} "${source}" "${source}")
if(METHOD STREQUAL "synthesize-selector")
    run_cli(1 ${METHOD} "${source}" "${WORK}/absent.bri" --max-assignments=1)
    if(EXISTS "${WORK}/absent.bri")
        message(FATAL_ERROR "Domain-limited selector created an incomplete artifact")
    endif()
    run_cli(0 build md5 "6d6435?1" "${WORK}/nibble-source.bri")
    expect_match("${cli_output}" "unknown bits: 4" "Known nibbles were not baked into the selector source")
    run_cli(0 ${METHOD} "${WORK}/nibble-source.bri" "${WORK}/nibble.bri")
    run_cli(0 solve "${WORK}/nibble.bri" b682c4079aa8cae8524986bf8de47f5c)
    expect_output("6d643521" "Nibble-specialized inverse did not recover md5!")
    run_cli(2 solve "${WORK}/nibble.bri" 0b5aeacaa0f4f17d5fd7a8ea0a855e1f)
endif()
run_cli(0 ${METHOD} "${source}" "${inverse}")
expect_sha256("${source}" "${source_hash}" "Synthesis modified the input artifact")

run_cli(0 solve "${inverse}" b682c4079aa8cae8524986bf8de47f5c)
expect_output("6d643521" "Synthesized MD5 inverse did not recover md5!")
run_cli(0 solve "${inverse}" 0b5aeacaa0f4f17d5fd7a8ea0a855e1f)
expect_output("6d64353f" "Synthesized inverse could not serve a second target")
run_cli(2 solve "${inverse}" 00000000000000000000000000000000)

run_cli_keeping("${inverse}" 1 export-cpp "${inverse}" "${inverse}")
file(WRITE "${WORK}/unsynthesized.h" "existing header")
run_cli_keeping("${WORK}/unsynthesized.h" 1 export-cpp "${source}" "${WORK}/unsynthesized.h")
run_cli(0 export-cpp "${inverse}" "${WORK}/md5_inverse.h")
compile_and_run(md5_export_check.cpp)
